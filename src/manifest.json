{
  "manifest_version": 2,
  "name": "划词翻译 · Selection Translator",
  "version": "1.8.0-beta",
  "description": "在 Zotero 阅读器中划词即译，支持 DeepL 免费网页版、多种翻译引擎和 AI 大模型，并可一键高亮/划线并把译文写入标注评论。",
  "author": "Zotero Selection Translator contributors",
  "homepage_url": "https://github.com/all11250/zotero-selection-translator",
  "icons": {
    "48": "content/icons/icon-48.png",
    "96": "content/icons/icon-96.png",
    "128": "content/icons/icon-128.png"
  },
  "applications": {
    "zotero": {
      "id": "selection-translator@zotero.local",
      "update_url": "https://raw.githubusercontent.com/all11250/zotero-selection-translator/main/update.json",
      "strict_min_version": "7.0",
      "strict_max_version": "10.*"
    }
  }
}
